---
import Layout from '../layouts/Layout.astro';
import { TOOLS_DATA, TECHNIQUES_DATA, SKILL_TIPS_DATA } from '../data/academy';
import { 
  GraduationCap, Sparkles, Wrench, Droplets, Flame, 
  Snowflake, Clock, CheckCircle2, ChevronRight, Layers 
} from 'lucide-react';
---

<Layout
  title="调酒学堂 · 基础知识、核心工具、7大手法与进阶技巧 · Elixir & Shadow"
  description="系统的专业调酒教学：波士顿摇壶与日式Cobbler摇壶差异、7大调制技法（Shake/Stir/Build/Muddle/Blend/Layer/Float）图解与透明冰块控温指南。"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-16">
    
    <!-- Header Banner -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-500/10 text-gold-400 text-xs font-semibold uppercase tracking-wider">
        <GraduationCap class="w-3.5 h-3.5" />
        <span>Alchemist Bartending Academy</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-serif font-black text-slate-100">
        调酒基础与进阶学堂
      </h1>
      <p class="text-slate-400 text-xs sm:text-sm leading-relaxed">
        从器具构造原理、流体动力学到 7 大核心调制手法，搭建扎实严谨的调酒知识体系。
      </p>
    </div>

    <!-- Quick Navigation Anchors -->
    <div class="flex flex-wrap items-center justify-center gap-3 text-xs">
      <a href="#tools" class="px-4 py-2 rounded-xl bg-obsidian-850 border border-gold-500/20 text-gold-300 hover:border-gold-500/50 transition-colors flex items-center gap-1.5 font-medium">
        <Wrench class="w-3.5 h-3.5" />
        <span>调酒核心器具</span>
      </a>
      <a href="#techniques" class="px-4 py-2 rounded-xl bg-obsidian-850 border border-gold-500/20 text-gold-300 hover:border-gold-500/50 transition-colors flex items-center gap-1.5 font-medium">
        <Droplets class="w-3.5 h-3.5" />
        <span>7大核心调制手法</span>
      </a>
      <a href="#tips" class="px-4 py-2 rounded-xl bg-obsidian-850 border border-gold-500/20 text-gold-300 hover:border-gold-500/50 transition-colors flex items-center gap-1.5 font-medium">
        <Flame class="w-3.5 h-3.5" />
        <span>进阶秘诀与技巧</span>
      </a>
    </div>

    <!-- 1. Tools Section -->
    <section id="tools" class="space-y-8 pt-6">
      <div class="border-b border-gold-500/20 pb-4">
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-100 flex items-center gap-2">
          <Wrench class="w-6 h-6 text-gold-400" />
          <span>核心调酒器具指南 (Bar Tools)</span>
        </h2>
        <p class="text-xs text-slate-400 mt-1">工欲善其事，必先利其器。掌握不同器具的构造与使用场景。</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {TOOLS_DATA.map((tool) => (
          <div class="rounded-2xl bg-obsidian-850 border border-gold-500/20 p-6 space-y-4 hover:border-gold-500/50 transition-all shadow-gold-glow flex flex-col justify-between">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-gold-500/10 text-gold-300 border border-gold-500/20">
                  {tool.category}
                </span>
                <span class="text-xs text-slate-500 font-mono">{tool.keySpecs.split('：')[1]}</span>
              </div>

              <div>
                <h3 class="text-lg font-serif font-bold text-slate-100">{tool.name}</h3>
                <p class="text-xs text-gold-400">{tool.nameEn}</p>
              </div>

              <p class="text-xs text-slate-300 leading-relaxed text-justify">
                {tool.description}
              </p>

              {tool.types && tool.types.length > 0 && (
                <div class="space-y-1.5 pt-2 border-t border-white/5">
                  <span class="text-[11px] text-slate-400 font-semibold block">主要分类与区别：</span>
                  <ul class="space-y-1 text-xs text-slate-400">
                    {tool.types.map((type) => (
                      <li class="flex items-start gap-1.5">
                        <span class="text-gold-400">•</span>
                        <span>{type}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

            <div class="p-3 rounded-xl bg-obsidian-900/80 border border-white/5 text-[11px] text-slate-400 space-y-1">
              <strong class="text-gold-300 block">💡 调酒师使用诀窍：</strong>
              <p>{tool.usageTips}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 2. Seven Techniques Section -->
    <section id="techniques" class="space-y-8 pt-10">
      <div class="border-b border-gold-500/20 pb-4">
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-100 flex items-center gap-2">
          <Droplets class="w-6 h-6 text-gold-400" />
          <span>7 大核心调制技法详解 (Techniques)</span>
        </h2>
        <p class="text-xs text-slate-400 mt-1">
          Shake、Stir、Build、Muddle、Blend、Layer、Float 的动作要领、控温控水与物理原理。
        </p>
      </div>

      <div class="space-y-8">
        {TECHNIQUES_DATA.map((tech, idx) => (
          <div class="rounded-2xl bg-obsidian-850 border border-gold-500/20 p-6 sm:p-8 space-y-6 shadow-gold-glow">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/5 pb-4">
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-mono text-sm font-bold text-gold-400">0{idx + 1}</span>
                  <h3 class="text-xl sm:text-2xl font-serif font-bold text-slate-100">{tech.name}</h3>
                </div>
                <p class="text-xs text-gold-400/80">{tech.nameEn}</p>
              </div>

              <div class="flex items-center gap-3 text-xs">
                <span class="px-3 py-1 rounded-full bg-obsidian-900 border border-white/10 text-slate-300 flex items-center gap-1 font-mono">
                  <Clock class="w-3.5 h-3.5 text-gold-400" />
                  时长：{tech.duration}
                </span>
              </div>
            </div>

            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed text-justify">
              {tech.description}
            </p>

            <!-- Suitable for tags -->
            <div class="flex flex-wrap items-center gap-2 text-xs">
              <span class="text-slate-400 font-semibold">最适合酒款：</span>
              {tech.suitableFor.map((item) => (
                <span class="px-2.5 py-0.5 rounded-full bg-gold-500/10 text-gold-300 border border-gold-500/20">
                  {item}
                </span>
              ))}
            </div>

            <!-- Steps & ProTip Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 pt-2">
              <div class="lg:col-span-8 space-y-2.5">
                <span class="text-xs font-semibold text-gold-400 uppercase tracking-wider block">
                  标准化操作步骤 (Execution Steps)
                </span>
                <ol class="space-y-2 text-xs text-slate-300">
                  {tech.steps.map((step, i) => (
                    <li class="flex items-start gap-2 leading-relaxed">
                      <span class="font-mono text-gold-400 font-bold">{i + 1}.</span>
                      <span>{step}</span>
                    </li>
                  ))}
                </ol>
              </div>

              <div class="lg:col-span-4 p-4 rounded-xl bg-obsidian-900/80 border border-amber-500/20 space-y-1.5 text-xs text-slate-300 flex flex-col justify-center">
                <strong class="text-amber-400 flex items-center gap-1">
                  <Flame class="w-3.5 h-3.5" />
                  大师要领提示：
                </strong>
                <p class="leading-relaxed text-slate-400">{tech.proTip}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. Skill Tips & Bartender Secrets -->
    <section id="tips" class="space-y-8 pt-10">
      <div class="border-b border-gold-500/20 pb-4">
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-100 flex items-center gap-2">
          <Flame class="w-6 h-6 text-amber-400" />
          <span>进阶调酒美学与关键技巧 (Skills & Tips)</span>
        </h2>
        <p class="text-xs text-slate-400 mt-1">从杯口盐圈镶边到透明老冰控温控水，决定一杯鸡尾酒成败的微小细节。</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        {SKILL_TIPS_DATA.map((tip) => (
          <div class="rounded-2xl bg-obsidian-850 border border-gold-500/20 p-6 space-y-4 hover:border-gold-500/50 transition-all shadow-gold-glow flex flex-col justify-between">
            <div class="space-y-3">
              <div>
                <h3 class="text-lg font-serif font-bold text-slate-100">{tip.title}</h3>
                <p class="text-xs text-gold-400">{tip.subtitle}</p>
              </div>

              <p class="text-xs text-slate-300 leading-relaxed text-justify">
                {tip.content}
              </p>
            </div>

            <div class="space-y-2 pt-3 border-t border-white/5 text-xs">
              <span class="text-gold-300 font-semibold block">核心法则：</span>
              <ul class="space-y-1.5 text-slate-400">
                {tip.rules.map((rule) => (
                  <li class="flex items-start gap-1.5 text-[11px] leading-relaxed">
                    <CheckCircle2 class="w-3.5 h-3.5 text-gold-400 flex-shrink-0 mt-0.5" />
                    <span>{rule}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</Layout>
