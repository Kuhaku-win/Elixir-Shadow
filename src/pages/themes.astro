---
import Layout from '../layouts/Layout.astro';
import ThemeStudioExplorer from '../components/ThemeStudioExplorer';
import { Palette, Sparkles, Award, Wine, Layers, Flame, Compass, FileText, Image as ImageIcon } from 'lucide-react';
---

<Layout
  title="鸡尾酒美学主题工坊 · 5 大调酒设计世界观 · Elixir & Shadow"
  description="探索 Elixir & Shadow 的 5 大经典调酒美学世界观：暗黑奢华风、白兰极简风、复古怀旧风、翡翠夜宴风与赛博霓虹风。"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-12">
    
    <!-- Hero Header -->
    <div class="text-center space-y-4 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 text-gold-400 text-xs font-semibold uppercase tracking-wider border border-gold-500/20">
        <Palette class="w-3.5 h-3.5" />
        <span>Cocktail Aesthetics & Heritage Studio</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif font-black text-slate-100 tracking-tight leading-tight">
        鸡尾酒美学主题工坊<br />
        <span class="text-gold-gradient font-serif">5 大大师级设计世界观</span>
      </h1>

      <p class="text-xs sm:text-base text-slate-300 leading-relaxed max-w-2xl mx-auto">
        涵盖 5 大调酒美学世界观与 4 大先锋光标交互模态（原生极简、流体透镜、语义胶囊、暗室焦散）。键盘按 T 键换主题、按 C 键换光标，或通过导航栏随时自由切换。
      </p>
    </div>

    <!-- Interactive Theme Studio React Island -->
    <ThemeStudioExplorer client:load />

  </div>
</Layout>
