---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchTriggerManager from '../components/SearchTriggerManager';
import ThemeTriggerManager from '../components/ThemeTriggerManager';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  recipeSchemaJson?: string;
}

const {
  title = 'Elixir & Shadow / 影之甘露 · 专业鸡尾酒配方大全与调酒知识库',
  description = '在光影与烈酒的交汇处，调制灵魂解药。收录 100+ 款 IBA 国际认证经典配方、大赛冠军作品、调酒大师专栏、原材料百科全书、智能原料平替与家庭派对酒单生成系统。',
  image = 'https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?auto=format&fit=crop&w=1200&q=80',
  recipeSchemaJson
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://elixir-and-shadow.pages.dev');
---

<!doctype html>
<html lang="zh-CN" class="dark" data-theme="dark-luxury">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Zero-flicker Theme Initialization -->
    <script is:inline>
      (function() {
        try {
          const savedTheme = localStorage.getItem('elixir_theme') || 'dark-luxury';
          document.documentElement.setAttribute('data-theme', savedTheme);
        } catch (e) {
          console.error(e);
        }
      })();
    </script>

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="鸡尾酒配方, 调酒知识, 鸡尾酒吧台, 原料平替, 派对酒单, IBA标准鸡尾酒, 金酒, 伏特加, 朗姆酒, 威士忌, 龙舌兰, 白兰地, 调酒手法, 鸡尾酒材料反查, 调酒美学主题" />
    <meta name="theme-color" content="#07070a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="影之甘露" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Recipe Schema (JSON-LD) -->
    {recipeSchemaJson && (
      <script type="application/ld+json" set:html={recipeSchemaJson} />
    )}
  </head>
  <body class="min-h-screen bg-obsidian-950 text-slate-100 flex flex-col antialiased selection:bg-gold-500/30 selection:text-gold-200 pb-[calc(4rem+env(safe-area-inset-bottom,0px))] lg:pb-0">
    <Header />
    
    <main class="flex-1 w-full">
      <slot />
    </main>

    <Footer />

    <!-- Mobile Persistent Bottom Navigation Bar -->
    <MobileBottomNav />

    <!-- Global Search React Island -->
    <SearchTriggerManager client:load />

    <!-- Global Theme Switcher React Island -->
    <ThemeTriggerManager client:load />
  </body>
</html>
