---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchTriggerManager from '../components/SearchTriggerManager';
import ThemeTriggerManager from '../components/ThemeTriggerManager';
import ContactModal from '../components/ContactModal';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import LiquidMagneticCursor from '../components/LiquidMagneticCursor';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  recipeSchemaJson?: string;
}

const {
  title = 'Elixir & Shadow / 影之甘露 · 专业鸡尾酒配方大全与调酒知识库',
  description = '在光影与烈酒的交汇处，调制灵魂解药。收录 100+ 款 IBA 国际认证经典配方、大赛冠军作品、调酒大师专栏、原材料百科全书、智能原料平替与家庭派对酒单生成系统。',
  image = 'https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?auto=format&fit=crop&w=1200&q=80',
  recipeSchemaJson
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://mixshadow.xyz');
---

<!doctype html>
<html lang="zh-CN" class="dark" data-theme="dark-luxury" data-cursor-mode="native">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Zero-flicker Theme & Cursor Initialization -->
    <script is:inline>
      (function() {
        try {
          const savedTheme = localStorage.getItem('elixir_theme') || 'dark-luxury';
          const savedCursor = localStorage.getItem('elixir_cursor_mode') || 'native';
          document.documentElement.setAttribute('data-theme', savedTheme);
          document.documentElement.setAttribute('data-cursor-mode', savedCursor);
        } catch (e) {
          console.error(e);
        }
      })();
    </script>

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="鸡尾酒配方, 调酒知识, 鸡尾酒吧台, 原料平替, 派对酒单, IBA标准鸡尾酒, 金酒, 伏特加, 朗姆酒, 威士忌, 龙舌兰, 白兰地, 调酒手法, 鸡尾酒材料反查, 调酒美学主题" />
    <meta name="theme-color" content="#07070a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="影之甘露" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Recipe Schema (JSON-LD) -->
    {recipeSchemaJson && (
      <script type="application/ld+json" set:html={recipeSchemaJson} />
    )}

    <!-- 百度自动推送：每次用户访问自动通知百度爬虫收录，加速 SEO -->
    <script is:inline>
      (function() {
        var bp = document.createElement('script');
        var curProtocol = window.location.protocol.split(':')[0];
        if (curProtocol === 'https') {
          bp.src = 'https://zz.bdstatic.com/linksubmit/push.js';
        } else {
          bp.src = 'http://push.zhanzhang.baidu.com/push.js';
        }
        var s = document.getElementsByTagName("script")[0];
        s.parentNode.insertBefore(bp, s);
      })();
    </script>

    <!-- 百度统计：替换下方 token 为你在 https://tongji.baidu.com/ 申请的真实 token -->
    <!-- <script is:inline>
      var _hmt = _hmt || [];
      (function() {
        var hm = document.createElement("script");
        hm.src = "https://hm.baidu.com/hm.js?YOUR_BAIDU_TONGJI_TOKEN";
        var s = document.getElementsByTagName("script")[0];
        s.parentNode.insertBefore(hm, s);
      })();
    </script> -->
  </head>
  <body class="min-h-screen bg-obsidian-950 text-slate-100 flex flex-col antialiased selection:bg-gold-500/30 selection:text-gold-200 pb-[calc(4rem+env(safe-area-inset-bottom,0px))] lg:pb-0 relative bg-dot-grid">
    
    <!-- Top Hairline Amber-Gold Scroll Progress Bar (Santioni & Melius Style) -->
    <div
      id="elixir-scroll-progress"
      class="fixed top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-gold-500 via-amber-400 to-amber-600 z-50 origin-left scale-x-0 transition-transform duration-75 pointer-events-none shadow-[0_0_8px_rgba(223,177,91,0.6)]"
      aria-hidden="true"
    />

    <Header />
    
    <main class="flex-1 w-full relative z-10">
      <slot />
    </main>

    <Footer />

    <!-- Mobile Persistent Bottom Navigation Bar -->
    <MobileBottomNav />

    <!-- Desktop Fluid Magnetic Cursor React Island -->
    <LiquidMagneticCursor client:load />

    <!-- Global Search React Island -->
    <SearchTriggerManager client:load />

    <!-- Global Theme Switcher React Island -->
    <ThemeTriggerManager client:load />

    <!-- Global Contact and Business Modal React Island -->
    <ContactModal client:load />

    <!-- Lenis Smooth Inertia Scroll & Scroll-linked Navigation Engine -->
    <script>
      import Lenis from 'lenis';

      // Initialize Lenis Smooth Scroll only when user prefers motion
      if (typeof window !== 'undefined' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({
          duration: 1.15,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), // Luxurious liquid inertia curve
          orientation: 'vertical',
          smoothWheel: true,
          touchMultiplier: 1.25,
        });

        // Link Lenis to RAF
        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        // Global Lenis Instance on window for optional external triggers
        (window as any).__lenis = lenis;

        // Scroll Progress Bar & Direction-aware Header
        const progressBar = document.getElementById('elixir-scroll-progress');
        const header = document.querySelector('header');
        let lastScrollY = 0;

        lenis.on('scroll', (e: { scroll: number; limit: number; velocity: number }) => {
          // 1. Update Scroll Progress Bar
          if (progressBar && e.limit > 0) {
            const progress = Math.min(1, Math.max(0, e.scroll / e.limit));
            progressBar.style.transform = `scaleX(${progress})`;
          }

          // 2. Direction-aware Header Collapse/Reveal
          if (header) {
            const currentY = e.scroll;
            if (currentY > 150 && currentY > lastScrollY && e.velocity > 1.2) {
              // Rapid scroll down: conceal header for immersion
              header.style.transform = 'translateY(-100%)';
            } else {
              // Scroll up or near top: reveal with backdrop blur
              header.style.transform = 'translateY(0)';
            }
            lastScrollY = currentY;
          }
        });
      }
    </script>
  </body>
</html>
